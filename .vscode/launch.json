{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run Tickets Event Backend",
      "request": "launch",
      "mainClass": "com.tickets.ApplicationKt",
      "projectName": "tickets-event-backend",
      "classPaths": [
        "${workspaceFolder}/build/install/tickets-event-backend/lib/*"
      ],
      "console": "integratedTerminal",
      "env": {
        "PORT": "8080",
        "MYSQL_HOST": "localhost",
        "MYSQL_PORT": "3306",
        "MYSQL_DATABASE": "tickets",
        "MYSQL_USER": "tickets",
        "MYSQL_PASSWORD": "tickets"
      },
      "preLaunchTask": "Debug: prepare backend"
    }
  ]
}
